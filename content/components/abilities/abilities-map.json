{
  "set": {
    "Name": "CardCustom",
    "position": { "x": -25, "y": 3, "z": 20 },
    "scale": { "x": 0.75, "y": 1, "z": 0.75 },
    "SidewaysCard": true
  },
  "fields":
  {  
       "identifier": "${Full Id}"
    ,  "Description": "${Name}"
    ,  "face": "images/${Full Id}-face.jpg"
    ,  "back": "images/${Full Id}-back.jpg"
    ,  "tags": { "split": "${Keywords}", "delimiter": "," }
    ,  "attribute": "${Attribute}"
    ,  "class": "${Class}"
    ,  "rating": "${Rating}"
    ,  "bag": "${Class}${Rating}Chest"
  }
}