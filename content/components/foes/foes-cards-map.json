{
  "set": {
      "Name": "CardCustom"
    , "scale": { "x": 1, "y": 1, "z": 1 }
    , "snappoints": {
      "cols": 5,
      "rows": 5,
      "gridX": 0.225,
      "gridZ": 0.225
    }
    , "bag": "FoesBox"
  },
  "fields":
  {  
      "identifier": "${Full Id}"
    , "Description": "${Name}"
    , "face": "images/${Full Id}-face.jpg"
    , "back": "images/${Full Id}-back.jpg"
    , "tags": { "split": "${Keywords}", "delimiter": "," }
  }
}
